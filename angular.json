{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "analytics": false,
        "packageManager": "pnpm",
        "schematicCollections": ["angular-eslint"]
    },
    "schematics": {
        "@schematics/angular:component": {
            "addTypeToClassName": true,
            "style": "scss",
            "type": "component"
        },
        "@schematics/angular:directive": {
            "addTypeToClassName": true,
            "type": "directive"
        },
        "@schematics/angular:service": {
            "addTypeToClassName": true,
            "type": "service"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    },
    "projects": {
        "app": {
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            }
                        ],
                        "browser": "src/main.ts",
                        "inlineStyleLanguage": "scss",
                        "styles": ["src/styles.scss"],
                        "sourceMap": true,
                        "tsConfig": "tsconfig.app.json"
                    },
                    "defaultConfiguration": "production",
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "outputHashing": "all",
                            "subresourceIntegrity": true
                        },
                        "development": {
                            "namedChunks": true,
                            "optimization": false,
                            "extractLicenses": false
                        }
                    }
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "allowedHosts": ["localhost.www.dndmapp.dev"],
                        "host": "127.0.0.1",
                        "buildTarget": "app:build:development",
                        "port": 4000,
                        "ssl": true,
                        "sslCert": ".ssl/cert.pem",
                        "sslKey": ".ssl/key.pem"
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "browsers": ["chromium"],
                        "buildTarget": "app:build:development",
                        "coverage": true,
                        "coverageExclude": ["**/config/**", "**/test/**", "**/index.ts", "**/main.ts"],
                        "coverageReporters": [
                            [
                                "html",
                                {
                                    "subdir": "."
                                }
                            ],
                            "text-summary"
                        ],
                        "coverageThresholds": {
                            "branches": 80,
                            "functions": 80,
                            "lines": 80,
                            "statements": 80
                        },
                        "headless": true,
                        "include": ["**/*.spec.ts"],
                        "isolate": true,
                        "runner": "vitest",
                        "runnerConfig": "vitest.config.ts",
                        "tsConfig": "tsconfig.spec.json"
                    },
                    "defaultConfiguration": "development",
                    "configurations": {
                        "development": {
                            "reporters": [
                                "dot",
                                [
                                    "html",
                                    {
                                        "outputFile": "reports/index.html"
                                    }
                                ]
                            ],
                            "ui": true,
                            "watch": true
                        },
                        "ci": {
                            "reporters": [
                                "dot",
                                "github-actions",
                                [
                                    "html",
                                    {
                                        "outputFile": "reports/index.html"
                                    }
                                ]
                            ],
                            "watch": false
                        }
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
                    }
                }
            }
        }
    }
}
