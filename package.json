{
  "name": "angular-app-template",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "scripts": {
    "prepare": "husky || true",
    "playwright-install-browsers": "playwright install chromium --with-deps",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test-ci": "ng test -c ci",
    "lint-ts": "ng lint",
    "lint-md": "markdownlint-cli2",
    "format": "prettier -w .",
    "format-check": "prettier -l ."
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@angular/cdk": "~22.0.6",
    "@angular/common": "~22.0.8",
    "@angular/compiler": "~22.0.8",
    "@angular/core": "~22.0.8",
    "@angular/forms": "~22.0.8",
    "@angular/platform-browser": "~22.0.8",
    "@angular/router": "~22.0.8",
    "rxjs": "~7.8.0",
    "tslib": "~2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "~22.1.0",
    "@angular/build": "~22.0.8",
    "@angular/cli": "~22.0.8",
    "@angular/compiler-cli": "~22.0.8",
    "@commitlint/cli": "~21.2.1",
    "@commitlint/config-conventional": "~21.2.0",
    "@eslint/js": "~10.0.1",
    "@vitest/browser-playwright": "~4.1.10",
    "@vitest/coverage-v8": "~4.1.10",
    "@vitest/ui": "~4.1.10",
    "angular-eslint": "~22.1.0",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "~10.1.8",
    "husky": "~9.1.7",
    "lint-staged": "~17.2.0",
    "markdownlint-cli2": "~0.23.2",
    "playwright": "~1.62.0",
    "prettier": "~3.9.6",
    "prettier-plugin-organize-imports": "~4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.65.0",
    "vitest": "~4.1.10"
  }
}
