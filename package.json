{
  "name": "template-app-angular",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "scripts": {
    "prepare": "husky || true",
    "playwright-install-browsers": "playwright install chromium --with-deps",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test-ci": "ng test -c ci",
    "lint-ts": "ng lint",
    "lint-css": "stylelint \"**/*.scss\"",
    "lint-md": "markdownlint-cli2",
    "format": "prettier -w .",
    "format-check": "prettier -l ."
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@angular/cdk": "catalog:default",
    "@angular/common": "catalog:default",
    "@angular/compiler": "catalog:default",
    "@angular/core": "catalog:default",
    "@angular/forms": "catalog:default",
    "@angular/platform-browser": "catalog:default",
    "@angular/router": "catalog:default",
    "rxjs": "catalog:default",
    "tslib": "catalog:default"
  },
  "devDependencies": {
    "@angular-eslint/builder": "catalog:default",
    "@angular/build": "catalog:default",
    "@angular/cli": "catalog:default",
    "@angular/compiler-cli": "catalog:default",
    "@commitlint/cli": "catalog:default",
    "@commitlint/config-conventional": "catalog:default",
    "@eslint/js": "catalog:default",
    "@types/node": "catalog:default",
    "@vitest/browser-playwright": "catalog:default",
    "@vitest/coverage-v8": "catalog:default",
    "@vitest/ui": "catalog:default",
    "angular-eslint": "catalog:default",
    "eslint": "catalog:default",
    "eslint-config-prettier": "catalog:default",
    "husky": "catalog:default",
    "lint-staged": "catalog:default",
    "markdownlint-cli2": "catalog:default",
    "playwright": "catalog:default",
    "prettier": "catalog:default",
    "prettier-plugin-organize-imports": "catalog:default",
    "stylelint": "catalog:default",
    "stylelint-config-recess-order": "catalog:default",
    "stylelint-config-standard-scss": "catalog:default",
    "stylelint-order": "catalog:default",
    "typescript": "catalog:default",
    "typescript-eslint": "catalog:default",
    "vitest": "catalog:default"
  }
}
